<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect missing illustrations, mascot, and question images directly to the neetbuddy-media CDN
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^illustrations/(.*)$ https://cdn.jsdelivr.net/gh/harshitraj4767-byte/neetbuddy-media@main/public/illustrations/$1 [R=302,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^mascot/(.*)$ https://cdn.jsdelivr.net/gh/harshitraj4767-byte/neetbuddy-media@main/public/mascot/$1 [R=302,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^img/data/(.*)$ https://cdn.jsdelivr.net/gh/harshitraj4767-byte/neetbuddy-media@main/public/img/data/$1 [R=302,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ncert/(.*)$ https://cdn.jsdelivr.net/gh/harshitraj4767-byte/neetbuddy-media@main/public/ncert/$1 [R=302,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
